@model OperaLearningSystem.Web.Areas.Admin.ViewModels.MasterCreateViewModel

@{
    ViewData["Title"] = "新增名家";
}

<link rel="stylesheet" href="~/css/admin/master.css" asp-append-version="true" />

<div id="master-edit-container">

    <div class="page-title">
        <i class="bi bi-plus-square text-muted"></i> 新增名家档案
    </div>

    <div class="edit-card">
        <form asp-action="Create" enctype="multipart/form-data" style="display: flex; flex-direction: column; height: 100%;">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="padding: 10px 25px 0;"></div>

            <div class="form-grid">

                <div class="left-column">
                    <div class="form-group">
                        <label asp-for="Name" class="control-label">名家姓名 <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="例如：梅兰芳" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size: 0.85rem;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CategoryId" class="control-label">所属剧种 <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select custom-select" asp-items="ViewBag.CategoryId">
                            <option value="">-- 请选择所属剧种 --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger" style="font-size: 0.85rem;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Rating" class="control-label">推荐评级 (1-5)</label>
                        <div class="rating-input-wrapper">
                            <input asp-for="Rating" class="form-control" type="number" min="1" max="5" placeholder="默认: 5" />
                            <i class="bi bi-star-fill text-warning"></i>
                        </div>
                        <span asp-validation-for="Rating" class="text-danger" style="font-size: 0.85rem;"></span>
                    </div>

                    <div class="form-group" style="margin-top: 25px;">
                        <label class="control-label">名家照片</label>
                        <div class="image-preview-box avatar-preview-box">
                            <div class="image-preview-placeholder">
                                <i class="bi bi-person-bounding-box" style="font-size: 2rem; color: #ddd;"></i>
                                <span>等待上传照片</span>
                            </div>
                        </div>
                        <input asp-for="ImageFile" type="file" class="form-control" style="padding: 6px;" />
                        <span asp-validation-for="ImageFile" class="text-danger" style="font-size: 0.85rem;"></span>
                    </div>
                </div>

                <div class="right-column" style="display: flex; flex-direction: column;">
                    <div class="form-group" style="flex: 1; display: flex; flex-direction: column; margin-bottom: 0;">
                        <label asp-for="Introduction" class="control-label">生平简介与艺术特色</label>
                        <textarea asp-for="Introduction" class="form-control" style="flex: 1; min-height: 350px;" placeholder="详细记录该名家的生平事迹、代表作及艺术风格..."></textarea>
                        <span asp-validation-for="Introduction" class="text-danger" style="font-size: 0.85rem;"></span>
                    </div>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-cancel">取消返回</a>
                <button type="submit" class="btn-save"><i class="bi bi-check2-circle"></i> 确认创建</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}