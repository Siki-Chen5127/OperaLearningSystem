@model OperaLearningSystem.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "修改密码";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
                <div style="height: 10px; background: linear-gradient(90deg, #8b0000, #d32f2f, #8b0000);"></div>

                <div class="card-body p-5">
                    <h3 class="text-center mb-4" style="color: #8b0000; font-family: 'Ma Shan Zheng', cursive; letter-spacing: 2px;">重塑密钥</h3>
                    <p class="text-muted text-center mb-4">定期修改密码，保障您的梨园名帖安全</p>

                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="OldPassword" class="form-control" placeholder="当前密码" style="border-radius: 10px;" />
                            <label asp-for="OldPassword">当前密码</label>
                            <span asp-validation-for="OldPassword" class="text-danger" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" class="form-control" placeholder="新密码" style="border-radius: 10px;" />
                            <label asp-for="NewPassword">新密码 (最少6位)</label>
                            <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="确认新密码" style="border-radius: 10px;" />
                            <label asp-for="ConfirmPassword">确认新密码</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="UserCenter" class="btn btn-light" style="border-radius: 50px; padding: 10px 30px;">返回</a>
                            <button type="submit" class="btn btn-danger" style="border-radius: 50px; padding: 10px 30px; background-color: #8b0000; border: none;">确认修改</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}