@{
    ViewData["Title"] = "邮件已发送";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <i class="bi bi-envelope-check" style="font-size: 4rem; color: #28a745;"></i>
            <h4 class="mt-4" style="color: #8b0000;">重置邮件已发送！</h4>
            <p class="text-muted mt-3">
                请检查您的邮箱收件箱（或垃圾邮件夹），点击邮件中的链接来重置您的密码。
            </p>
            <a asp-action="Login" class="btn btn-outline-danger mt-3">返回登录页</a>
        </div>
    </div>
</div>