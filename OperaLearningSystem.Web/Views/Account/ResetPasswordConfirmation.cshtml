@{
    ViewData["Title"] = "密码重置成功";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px; border-radius: 15px; overflow: hidden;">
        <div style="height: 10px; background: linear-gradient(90deg, #8b0000, #d32f2f, #8b0000);"></div>

        <div class="card-body p-5">
            <i class="fas fa-check-circle" style="font-size: 4rem; color: #28a745;"></i>
            <h4 class="mt-4" style="color: #8b0000; font-family: 'Ma Shan Zheng', cursive; letter-spacing: 2px;">重置成功</h4>
            <p class="text-muted mt-3">
                您的密码已成功重置，新密钥已生效。<br />请妥善保管，快去梨园入座吧！
            </p>
            <a asp-action="Login" asp-controller="Account" class="btn btn-danger mt-4" style="border-radius: 50px; padding: 10px 40px; background-color: #8b0000; border: none;">返回登录</a>
        </div>
    </div>
</div>