@model OperaLearningSystem.Core.Entities.AdminApplication
@{
    ViewData["Title"] = "递交拜帖 - 梨园共创";
}

<style>
    /* 宣纸质感的极简卡片 */
    .apply-paper {
        background: #faf8f5;
        border: 1px solid #e8dfd5;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 50px;
    }
    /* 古风主按钮 */
    .btn-ancient-primary {
        background-color: #8b0000;
        color: white;
        border-radius: 25px;
        padding: 12px 35px;
        border: none;
        letter-spacing: 2px;
        transition: 0.3s;
    }

        .btn-ancient-primary:hover {
            background-color: #5a0000;
            color: #f5f5f5;
        }
    /* 返回首页的次级按钮 */
    .btn-ancient-secondary {
        background-color: transparent;
        color: #666;
        border: 1px solid #ccc;
        border-radius: 25px;
        padding: 12px 35px;
        letter-spacing: 1px;
        transition: 0.3s;
        text-decoration: none;
    }

        .btn-ancient-secondary:hover {
            background-color: #f0ece6;
            color: #333;
        }
</style>

<div class="container mt-5 pt-4 mb-5" style="max-width: 650px;">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center mb-4" style="background: transparent; border: 1px dashed #198754; color: #198754;">
            <i class="fas fa-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center mb-4" style="background: transparent; border: 1px dashed #dc3545; color: #dc3545;">
            <i class="fas fa-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="apply-paper text-center">
        <h2 style="font-family: 'Ma Shan Zheng', cursive; color: #8b0000; margin-bottom: 40px; letter-spacing: 3px;">
            <i class="fas fa-feather-alt"></i> 梨园共创拜帖
        </h2>

        @if (ViewBag.Status == "AlreadyAdmin")
        {
            <p class="fs-5 mb-4" style="color: #333; font-family: 'SourceHanSerifSC', serif;">您已是尊贵的梨园共创者，无需再次递交拜帖。</p>

            @if (!User.IsInRole("Admin") && !User.IsInRole("SuperAdmin"))
            {
                <div class="alert mb-4 text-center" style="background: transparent; border: 1px dashed #d4af37; color: #8b0000;">
                    <i class="fas fa-bell"></i> 掌印已恩准您的拜帖！请点击右上角<strong>【退出梨园】并重新登录</strong>.
                </div>
            }

            <div class="d-flex justify-content-center gap-4 mt-5">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-ancient-primary">进入管理后台</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-ancient-secondary">返回首页</a>
            </div>
        }
        else if (Model != null && Model.Status == 0)
        {
            <i class="fas fa-hourglass-half fa-3x mb-4 text-warning" style="opacity: 0.7;"></i>
            <p class="fs-5 mb-2" style="color: #333;">您的拜帖已呈递，正等待【梨园掌印】亲自审阅...</p>
            <p class="text-muted mb-4" style="font-size: 0.9rem;">递交时间：@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

            <div class="d-flex justify-content-center mt-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-ancient-secondary">返回首页静候</a>
            </div>
        }
        else
        {
            @if (Model != null && Model.Status == 2)
            {
                <div class="p-3 mb-4 text-start" style="background: rgba(220,53,69,0.05); border-left: 3px solid #dc3545; border-radius: 4px;">
                    <strong class="text-danger"><i class="fas fa-comment-slash"></i> 掌印批复：</strong>
                    <span class="text-dark">@(string.IsNullOrEmpty(Model.RejectReason) ? "资历尚浅，望继续沉淀。" : Model.RejectReason)</span>
                    <div class="text-muted mt-1" style="font-size: 0.85em;">您可以修改缘由后，再次呈递拜帖。</div>
                </div>
            }

            <form asp-action="SubmitApply" method="post" class="text-start">
                <div class="mb-4">
                    <textarea name="reason" class="form-control" rows="6"
                          placeholder="请写下您与戏曲的渊源，或希望为梨园贡献的心意...（不少于10字）"
                          style="background: #fff; border: 1px solid #e0d0b5; border-radius: 8px; resize: none; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);"></textarea>
                </div>

                <div class="d-flex justify-content-center gap-4 mt-5">
                    <button type="submit" class="btn btn-ancient-primary">递交拜帖</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-ancient-secondary">拂衣归去 (首页)</a>
                </div>
            </form>
        }
    </div>
</div>