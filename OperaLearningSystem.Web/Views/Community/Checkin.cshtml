@{
    ViewData["Title"] = "戏台打卡";
    var authed = User.Identity?.IsAuthenticated == true;
    var qsYsl = string.Equals(Context.Request.Query["yueshilouReturn"].ToString(), "1", StringComparison.Ordinal);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/Community/daka.css" asp-append-version="true" />
}

<div class="yaji-split-layout">

    <aside class="yaji-pane-left">
        <div class="pane-left-inner">
            <header class="yaji-hero" data-aos="fade-down">
                <h1>行迹打卡 </h1>
                <p class="yaji-hero-sub">执笔写浮生，方寸见天地 — 记录你的专属戏台行迹</p>
                <div class="yaji-hero-links">
                    @if (qsYsl)
                    {
                        <a asp-controller="Home" asp-action="Index" asp-route-yueshilouReturn="1" class="yaji-link-pill">回阅是楼</a>
                    }
                    <a asp-controller="Community" asp-action="Index" asp-route-yueshilouReturn="@(qsYsl ? "1" : null)" class="yaji-link-pill">去往雅集</a>
                </div>
            </header>

            <div class="compose-paper" data-aos="fade-up" data-aos-delay="100">
                <div class="compose-form">
                    <input type="text" id="ci-title" class="yaji-field title-field" placeholder="打卡标题" />

                    <div class="field-row">
                        <div class="field-group">
                            <i class="fas fa-map-marker-alt field-icon"></i>
                            <input type="text" id="ci-region" class="yaji-field" placeholder="戏台坐标/地域" />
                        </div>
                        <div class="field-group">
                            <i class="fas fa-tag field-icon"></i>
                            <input type="text" id="ci-tags" class="yaji-field" placeholder="话题标签" />
                        </div>
                    </div>

                    <textarea id="ci-body" class="yaji-field body-field" placeholder="游览感悟、建筑考究或听戏心得..."></textarea>

                    <div class="media-workspace">
                        <div class="media-header">
                            <span class="media-title"><i class="fas fa-image"></i> 附上影像 / 票根</span>
                            <label for="ci-media-file" class="upload-add-btn"><i class="fas fa-plus"></i> 添加影像</label>
                            <input type="file" id="ci-media-file" accept="image/*,video/*" multiple style="display:none;" />
                        </div>
                        <div id="ci-media-preview-container" class="media-preview-grid">
                        </div>
                    </div>

                    <div class="compose-footer">
                        <div class="stamp-action">
                            <button type="button" class="btn-stamp" id="ci-submit">
                                <span>落印<br>成卷</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <main class="yaji-pane-right">
        <div class="pane-right-inner">

            <!-- ====== 大气夺目的顶部双切页签 ====== -->
            <div class="yaji-view-tabs" data-aos="fade-down">
                <button type="button" class="view-tab active" id="tab-feed-view">
                    <span>往期行踪</span>
                </button>
                <button type="button" class="view-tab" id="tab-map-view">
                    <span>行迹舆图</span>
                </button>
            </div>

            <!-- 工具栏 -->
            <div class="yaji-toolbar-wrap" id="yaji-toolbar-wrap" data-aos="fade-down" data-aos-delay="50">
                <div class="yaji-toolbar">
                    <div class="toolbar-title">行迹管理</div>
                    <div class="yaji-search-wrap">
                        <input type="search" id="yajiSearch" autocomplete="off" placeholder="搜索你的行迹…" aria-label="搜索" />
                        <span class="yaji-search-icon"><i class="fas fa-search"></i></span>
                    </div>
                    <div class="yaji-toolbar-actions">
                        <button type="button" class="yaji-icon-btn" id="yajiRefresh" title="刷新列表"><i class="fas fa-sync-alt"></i></button>
                    </div>
                </div>
            </div>

            <!-- 帖子列表坑位 -->
            <div id="yajiFeedHost" class="yaji-feed" data-aos="fade-up" data-aos-delay="100">
                <div class="yaji-loading"><i class="fas fa-circle-notch fa-spin"></i> 展开书卷中…</div>
            </div>

            <!-- 高德地图坑位 -->
            <div id="yajiMapHost" style="display: none; width: 100%; height: 75vh; border-radius: 8px; border: 2px solid #dcb589; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-top: 10px;"></div>

        </div>
    </main>

    <div style="display: none;" aria-hidden="true">
        <div id="yajiSortGroup"><button class="yaji-sort-btn active" data-sort="time"></button></div>
        <input type="text" id="yajiRegion" />
        <button id="yajiToggleRegion"></button>
        <div id="yajiWordCloud"></div>
    </div>
    <div id="yaji-confirm-modal" class="yaji-confirm-overlay" aria-hidden="true">
        <div class="yaji-confirm-box">
            <div class="yaji-confirm-header">操作确认</div>
            <div class="yaji-confirm-body">确定要删除此行迹吗？此操作不可逆。</div>
            <div class="yaji-confirm-footer">
                <button type="button" class="btn-cancel" id="btn-confirm-cancel">取消</button>
                <button type="button" class="btn-delete" id="btn-confirm-delete">删除</button>
            </div>
        </div>
    </div>
    <div id="yaji-toast" class="yaji-toast">
        <i class="fas fa-bell"></i> <span id="yaji-toast-msg">提示内容</span>
    </div>
</div>


@section Scripts {
    <!-- 1. 密钥配置 -->
    <script type="text/javascript">
        window._AMapSecurityConfig = {
            securityJsCode: '3d8373692863bd496c32aecbec19a863',
        }
    </script>
    <script src="https://webapi.amap.com/loader.js"></script>
    <script src="~/js/community-yaji-feed.js" asp-append-version="true"></script>

    <script>
        // 1. 拦截发往广场的请求，改道去个人长卷
        var originalFetch = window.fetch;
        window.fetch = function() {
            var url = arguments[0];
            if (typeof url === 'string' && url.includes('/api/community-feed/recommended?kind=1')) {
                arguments[0] = url.replace('/api/community-feed/recommended', '/api/community-feed/mine');
            }
            return originalFetch.apply(this, arguments);
        };

        // 2. 全局变量与弹窗工具
        window.checkinUploadUrls = [];
        window.isAuthed = @authed.ToString().ToLowerInvariant();

        window.showToast = function(message) {
            var toast = document.getElementById('yaji-toast');
            if(!toast) { alert(message); return; } // 防御：如果忘加HTML，至少有原生弹窗
            var msgEl = document.getElementById('yaji-toast-msg');
            if(msgEl) msgEl.textContent = message;
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 3000);
        };

        // 3. 初始化底部的帖子列表
        if (window.initYajiFeed) {
            initYajiFeed({
                postKind: 1,
                reactionSet: 'checkin',
                showMediaInFeed: true,
                authed: window.isAuthed,
                emptyHtml: '<div class="yaji-empty" data-aos="fade-in"><i class="fas fa-scroll"></i>文牒尚空<br/><small>在左侧落笔，留下你的第一串足迹吧。</small></div>'
            });
        }

        // 4. 监听右侧列表，动态注入“撤下此卷 (删除)”按钮
        var feedHost = document.getElementById('yajiFeedHost');
        if (feedHost) {
            var observer = new MutationObserver(function() {
                var rows = feedHost.querySelectorAll('.yaji-row');
                rows.forEach(function(row) {
                    var actionsDiv = row.querySelector('.yaji-actions');
                    if (actionsDiv && !actionsDiv.querySelector('.btn-delete-post')) {
                        var postId = row.getAttribute('data-id');
                        var delBtn = document.createElement('button');
                        delBtn.className = 'btn-delete-post';
                        delBtn.innerHTML = '<i class="fas fa-trash-alt"></i> 删除';
                        delBtn.onclick = function() { window.deletePost(postId); };
                        actionsDiv.appendChild(delBtn);
                    }
                });
            });
            observer.observe(feedHost, { childList: true, subtree: true });
        }

        // 自定义确认弹窗逻辑 
        window.customConfirm = function(message) {
            return new Promise(function(resolve) {
                var overlay = document.getElementById('yaji-confirm-modal');
                var bodyEl = overlay.querySelector('.yaji-confirm-body');
                var btnCancel = document.getElementById('btn-confirm-cancel');
                var btnDelete = document.getElementById('btn-confirm-delete');

                bodyEl.textContent = message;
                overlay.classList.add('show');

                // 点击后的清理与回调
                var cleanup = function(result) {
                    overlay.classList.remove('show');
                    btnCancel.onclick = null;
                    btnDelete.onclick = null;
                    resolve(result);
                };

                btnCancel.onclick = function() { cleanup(false); };
                btnDelete.onclick = function() { cleanup(true); };
            });
        };

        //删除逻辑：使用自定义弹窗
        window.deletePost = async function(postId) {
            var confirmed = await window.customConfirm('确定要删除此行迹吗？此操作不可逆。');
            if (!confirmed) return; // 用户点了取消，直接退出

            try {
                var r = await fetch('/api/community-feed/' + postId, { method: 'DELETE', credentials: 'same-origin' });
                if (r.ok) {
                    window.showToast('行迹已删除。');
                    if (window.yajiReloadFeed) window.yajiReloadFeed();
                } else {
                    window.showToast('删除失败：' + (await r.text()));
                }
            } catch (e) {
                window.showToast('网络波动，删除失败。');
            }
        };

        // 5. 影像上传与预览区逻辑
        window.renderPreviews = function() {
            var container = document.getElementById('ci-media-preview-container');
            if(!container) return; // 防御
            container.innerHTML = '';
            if(window.checkinUploadUrls.length === 0) {
                container.innerHTML = '<span class="empty-media-hint">暂未拓印影像...</span>';
                return;
            }
            window.checkinUploadUrls.forEach(function(url, index) {
                var item = document.createElement('div');
                item.className = 'preview-item';
                var isVideo = url.match(/\.(mp4|webm|ogg)$/i);
                var mediaHtml = isVideo ? `<video src="${url}" muted autoplay loop></video>` : `<img src="${url}" alt="影像" />`;
                item.innerHTML = mediaHtml + `<button type="button" class="preview-del-btn" onclick="deletePreview(${index})"><i class="fas fa-times"></i></button>`;
                container.appendChild(item);
            });
        };

        window.deletePreview = function(idx) {
            window.checkinUploadUrls.splice(idx, 1);
            window.renderPreviews();
        };

        window.renderPreviews(); // 首次加载空状态

        var fileInput = document.getElementById('ci-media-file');
        if (fileInput) {
            fileInput.addEventListener('change', async function () {
                if (!this.files || !this.files.length) return;
                if (!window.isAuthed) { window.showToast('请先登录，方可留名。'); this.value = ''; return; }

                var container = document.getElementById('ci-media-preview-container');
                if(container) container.innerHTML = '<div class="uploading-hint"><i class="fas fa-spinner fa-spin"></i> 影像拓印中...</div>';

                for (var i = 0; i < this.files.length; i++) {
                    var fd = new FormData();
                    fd.append('file', this.files[i]);
                    try {
                        var r = await fetch('/api/community-feed/upload-media', { method: 'POST', body: fd, credentials: 'same-origin' });
                        if (r.ok) {
                            var j = await r.json();
                            if (j && j.url) window.checkinUploadUrls.push(j.url);
                        }
                    } catch(e) { console.error('图片拓印失败', e); }
                }
                this.value = '';
                window.renderPreviews();
            });
        }

        // 6. 核心提交函数
        window.submitCheckinForm = async function(btnElement) {
            console.log("【步骤 1】触发落印点击");

            if (!window.isAuthed) {
                window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }

            // 安全地获取输入框，即使找不到也不会报错卡死
            var titleEl = document.getElementById('ci-title');
            var bodyEl = document.getElementById('ci-body');
            var tagsEl = document.getElementById('ci-tags');
            var regionEl = document.getElementById('ci-region');

            var bodyObj = {
                title: titleEl ? titleEl.value.trim() : "",
                content: bodyEl ? bodyEl.value.trim() : "",
                categoryId: 0,
                topicTags: tagsEl ? tagsEl.value.trim() : "",
                regionLabel: regionEl ? regionEl.value.trim() : "",
                mediaUrlsJson: JSON.stringify(window.checkinUploadUrls)
            };

            if (!bodyObj.title || !bodyObj.content) {
                window.showToast('请将标题与行迹感悟填写完整。');
                return;
            }

            console.log("【步骤 2】数据校验通过，锁定按钮状态");
            btnElement.classList.add('loading');

            try {
                var r = await fetch('/api/community-feed/checkin', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyObj)
                });

                console.log("【步骤 3】请求结束，解锁按钮。后端返回状态:", r.status);
                btnElement.classList.remove('loading');

                if (r.ok) {
                    // 清空表单
                    window.checkinUploadUrls = [];
                    if(titleEl) titleEl.value = '';
                    if(bodyEl) bodyEl.value = '';
                    if(tagsEl) tagsEl.value = '';
                    if(regionEl) regionEl.value = '';
                    window.renderPreviews();

                    // 刷新右侧列表
                    if (window.yajiReloadFeed) {
                        window.yajiReloadFeed();
                    } else {
                        window.location.reload(); // 最后的兜底
                    }
                    window.showToast('落印成功！行迹已载入文牒。');
                } else {
                    var errText = await r.text();
                    window.showToast('落印失败：' + errText);
                    console.error("【后端报错信息】", errText);
                }
            } catch (e) {
                btnElement.classList.remove('loading'); // 就算断网了，也要解锁按钮
                window.showToast('网络波动，请稍后再试。');
                console.error("【JS执行崩溃】", e);
            }
        };

        // 7. 终极强行绑定：绕过 HTML 拦截，直接在内存中给按钮接线
        var stampBtn = document.getElementById('ci-submit');
        if (stampBtn) {
            // 先解除可能存在的旧绑定，防止重复发帖
            var newBtn = stampBtn.cloneNode(true);
            stampBtn.parentNode.replaceChild(newBtn, stampBtn);

            // 重新获取干净的按钮并强行绑定点击事件
            document.getElementById('ci-submit').addEventListener('click', function() {
                // 加一个极其显眼的弹窗，只要点到了绝对会弹！
                window.submitCheckinForm(this);
            });
        } else {
            console.error("【系统日志】完蛋了，在页面上找不到 id 为 ci-submit 的按钮！");
        }

         // 8. 高德古风地图与顶级 Tab 切换逻辑
         var globalAMap = null; // 存放全局地图库对象
         var amapInstance = null; // 存放地图实例
         var mapMarkers = [];

         var tabFeed = document.getElementById('tab-feed-view');
         var tabMap = document.getElementById('tab-map-view');
         var feedHost = document.getElementById('yajiFeedHost');
         var mapHost = document.getElementById('yajiMapHost');
         var toolbarWrap = document.getElementById('yaji-toolbar-wrap');

         // 切换到：书卷模式
         tabFeed.addEventListener('click', function() {
             tabFeed.classList.add('active');
             tabMap.classList.remove('active');

             feedHost.style.display = 'flex';
             toolbarWrap.style.display = 'block'; // 显示搜索框
             mapHost.style.display = 'none';
         });

         // 切换到：舆图模式
         tabMap.addEventListener('click', function() {
             tabMap.classList.add('active');
             tabFeed.classList.remove('active');

             feedHost.style.display = 'none';
             toolbarWrap.style.display = 'none'; // 隐藏搜索框，让地图更大
             mapHost.style.display = 'block';

             // 只有第一次点击地图时才去加载高德，节约性能
             if (!amapInstance) {
                 mapHost.innerHTML = '<div class="yaji-loading" style="margin-top:100px;"><i class="fas fa-compass fa-spin"></i> 正在展开九州舆图...</div>';
                 loadAndInitAmap();
             } else {
                 renderMapMarkers(); // 重新画点
             }
         });

        // 安全加载高德地图的终极方法（带排错雷达）
                function loadAndInitAmap() {
                    if (typeof AMapLoader === 'undefined') {
                        mapHost.innerHTML = '<div style="text-align:center; padding: 50px; color: #8b1d1d;">地图核心组件被拦截，请关闭去广告插件后重试。</div>';
                        return;
                    }

                    AMapLoader.load({
                        key: 'd7cd94ef82e7b619dbebbdf6fb16a96f', // 再次提醒填写你申请的 Key
                        version: "2.0",
                        plugins: ['AMap.ToolBar', 'AMap.Scale', 'AMap.AutoComplete', 'AMap.PlaceSearch']
                    }).then((AMap) => {
                        globalAMap = AMap;
                        mapHost.innerHTML = ''; // 清掉 loading 文字

                        // 初始化地图
                        amapInstance = new globalAMap.Map('yajiMapHost', {
                            zoom: 4,
                            center: [104.114129, 37.550339],
                            viewMode: '3D',
                            mapStyle: 'amap://styles/macaron'
                        });

                        amapInstance.addControl(new globalAMap.ToolBar({ position: 'RB' }));

                        renderMapMarkers();
                    }).catch((e) => {
                        console.error("【高德调试 4】高德无情地拒绝了我们，报错原因：", e);
                        mapHost.innerHTML = '<div style="text-align:center; padding: 50px; color: #8b1d1d;">地图加载失败，请按 F12 查看控制台红字，检校通关文牒（Key）。</div>';
                    });
                }

        // 9.行迹流转渲染引擎
        var trajectoryLine = null; // 轨迹线
        var brushMarker = null;    // 动画笔锋

        async function renderMapMarkers() {
            if (!amapInstance || !globalAMap) return;

            // 1. 清理旧数据
            amapInstance.remove(mapMarkers);
            if (trajectoryLine) amapInstance.remove(trajectoryLine);
            if (brushMarker) amapInstance.remove(brushMarker);
            mapMarkers = [];
            var pathCoords = []; // 存放经纬度数组，用来画线

            try {
                // 2. 悄悄向后端拉取所有的打卡帖子
                var r = await fetch('/api/community-feed/mine', { credentials: 'same-origin' });
                if (!r.ok) return;
                var posts = await r.json();

                // 过滤掉没有填地域的帖子，并按时间从小到大排序（为了画出流转轨迹）
                posts = posts.filter(p => p.regionLabel).reverse();

                if (posts.length === 0) {
                    window.showToast("你的文牒中尚无带有地域信息的行迹。");
                    return;
                }

                // 3. 引入高德的“地理编码”插件（将文字地址转为经纬度）
                globalAMap.plugin('AMap.Geocoder', async function() {
                    var geocoder = new globalAMap.Geocoder({ city: "全国" });

                    // 封装一个 Promise 版本的地址解析
                    const getLngLat = (address) => new Promise((resolve) => {
                        geocoder.getLocation(address, function(status, result) {
                            if (status === 'complete' && result.geocodes.length) {
                                resolve(result.geocodes[0].location);
                            } else {
                                resolve(null); // 解析失败
                            }
                        });
                    });

                    // 4. 遍历帖子，依次在地图上盖“印章”
                    for (let i = 0; i < posts.length; i++) {
                        let post = posts[i];
                        let location = await getLngLat(post.regionLabel);

                        if (location) {
                            pathCoords.push(location); // 收集坐标画线

                            // 创建朱红印章 Marker
                            let marker = new globalAMap.Marker({
                                position: location,
                                content: `<div class="yaji-map-seal">${post.regionLabel.split('·')[0]}<br><span style="font-size:0.75rem">${post.title}</span></div>`,
                                offset: new globalAMap.Pixel(-30, -40), // 偏移量，让尖角对准坐标
                                extData: post // 把帖子数据绑在印章上，方便以后点击弹窗
                            });

                            marker.setMap(amapInstance);
                            mapMarkers.push(marker);
                        }
                    }

                    // 5. 大招开始：绘制轨迹红线并开启“行迹流转”动画
                    if (pathCoords.length > 1) {
                        // 画虚线
                        trajectoryLine = new globalAMap.Polyline({
                            path: pathCoords,
                            isOutline: true,
                            outlineColor: '#ffeecc',
                            borderWeight: 2,
                            strokeColor: "#8b1d1d",
                            strokeOpacity: 0.8,
                            strokeWeight: 4,
                            strokeStyle: "dashed", // 虚线
                            strokeDasharray: [10, 5],
                            lineJoin: 'round',
                            lineCap: 'round',
                            showDir: true // 显示箭头方向
                        });
                        trajectoryLine.setMap(amapInstance);

                        // 视角自适应，把所有轨迹包揽入屏幕
                        amapInstance.setFitView([trajectoryLine]);

                        // 创建沿着线跑的光球/笔锋
                        brushMarker = new globalAMap.Marker({
                            position: pathCoords[0],
                            content: '<div class="yaji-map-brush"></div>',
                            offset: new globalAMap.Pixel(-10, -10)
                        });
                        brushMarker.setMap(amapInstance);

                        // 开启流转动画（每小时 500000 公里的速度，可以自己调）
                        brushMarker.moveAlong(pathCoords, {
                            speed: 800000,
                            circular: true // 循环跑
                        });
                    } else if (pathCoords.length === 1) {
                        // 只有一个点，直接定位过去
                        amapInstance.setZoomAndCenter(8, pathCoords[0]);
                    }
                });

            } catch (e) {
                console.error("行迹解析失败：", e);
            }
        }
         
    </script>
}