@model OperaLearningSystem.Web.ViewModels.Community.CommunityPostCreateViewModel

@{
    ViewData["Title"] = "发布新帖";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/Community/create.css" />
}

<div class="create-page-container">
    <!-- 3D 空间氛围灯笼 -->
    <div class="lantern-wrapper lantern-far" style="top: 10%; left: 5%;">
        <img src="~/images/community/lantern.png" class="lantern-img" />
    </div>
    
    <div class="lantern-wrapper lantern-far" style="top: 40%; right: 10%;">
        <img src="~/images/community/lantern.png" class="lantern-img" />
    </div>

    <div class="lantern-wrapper lantern-mid" style="top: 20%; right: 20%;">
        <img src="~/images/community/lantern.png" class="lantern-img" />
    </div>

    <div class="lantern-wrapper lantern-mid" style="top: 70%; left: 15%;">
        <img src="~/images/community/lantern.png" class="lantern-img" />
    </div>

    <div class="lantern-wrapper lantern-close" style="top: 60%; right: -5%;">
        <img src="~/images/community/lantern.png" class="lantern-img" />
    </div>
    
    <div class="paper-card" data-aos="fade-up">

        <h2 class="page-title">
            <i class="fas fa-pen-nib" style="font-size:0.8em; margin-right:10px;"></i>提笔发帖
        </h2>
        <div class="page-subtitle">分享您的梨园见闻与艺术思考</div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Title" class="form-label">帖子标题</label>
                <input asp-for="Title" class="form-control-custom" placeholder="请输入标题..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="form-label">所属分类</label>
                <select asp-for="CategoryId" class="form-control-custom" asp-items="ViewBag.Categories">
                    <option value="">-- 请选择版块 --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Content" class="form-label">正文内容</label>
                <textarea asp-for="Content" class="form-control-custom" placeholder="请挥毫泼墨..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="action-bar">
                <a asp-action="Index" class="btn-custom btn-cancel">
                    <i class="fas fa-times"></i> 放弃
                </a>
                <button type="submit" class="btn-custom btn-submit">
                    <i class="fas fa-paper-plane"></i> 确认发布
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}