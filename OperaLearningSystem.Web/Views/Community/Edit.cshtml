@model OperaLearningSystem.Web.ViewModels.Community.CommunityPostEditViewModel

@{
    ViewData["Title"] = "润色戏文";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/Community/edit.css" />
}

<div class="edit-page-container">

    <div class="paper-card" data-aos="fade-up">

        <h2 class="page-title">
            <i class="fas fa-edit" style="font-size:0.8em; margin-right:10px;"></i>润色戏文
        </h2>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Title" class="form-label">帖子标题</label>
                <input asp-for="Title" class="form-control-custom" placeholder="请输入标题..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="form-label">所属分类</label>
                <select asp-for="CategoryId" class="form-control-custom" asp-items="ViewBag.Categories">
                    <option value="">-- 请选择版块 --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Content" class="form-label">正文内容</label>
                <textarea asp-for="Content" class="form-control-custom" placeholder="请挥毫泼墨..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="action-bar">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-custom btn-cancel">
                    <i class="fas fa-times"></i> 放弃修改
                </a>
                <button type="submit" class="btn-custom btn-save">
                    <i class="fas fa-save"></i> 保存修订
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}