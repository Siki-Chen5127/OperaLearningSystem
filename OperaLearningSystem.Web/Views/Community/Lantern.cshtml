@model IEnumerable<OperaLearningSystem.Core.Entities.CommunityPost>
@{
    ViewData["Title"] = "梨园心灯";
    var postList = Model.ToList();
}
@section Styles {
<style>
    body { background: #0a0806; margin: 0; overflow-x: hidden; }
    .hl-scene {
        position: fixed; inset: 0; z-index: 0;
        background: #0a0806 url('/images/entrance/tiantan.png') center/cover no-repeat;
        transform-style: preserve-3d; perspective: 1200px;
    }
    .hl-scene::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at 50% 40%, rgba(10,8,6,0.25) 0%, rgba(5,3,2,0.8) 70%, rgba(0,0,0,0.95) 100%);
    }
    .hl-depth-layer {
        position: absolute; inset: 0; pointer-events: none;
        transition: transform 0.1s ease-out; will-change: transform;
    }

    .hl-lantern {
        position: absolute; width: 20px; opacity: 0;
        animation: lanternFloat linear infinite; cursor: pointer;
        pointer-events: auto;
    }
    .hl-lantern::before {
        content: ''; position: absolute;
        inset: -20px; border-radius: 50%;
    }
    .hl-lantern:hover {
        animation-play-state: paused;
    }
    .hl-lantern-body {
        width: 100%; aspect-ratio: 0.6; border-radius: 50%;
        background: radial-gradient(circle at 50% 40%, #ff9933, #cc3300);
        box-shadow: 0 0 15px rgba(255,153,51,0.6), 0 0 30px rgba(255,100,30,0.3);
        position: relative; transition: transform 0.3s, box-shadow 0.3s;
    }
    .hl-lantern:hover .hl-lantern-body {
        transform: scale(1.8);
        box-shadow: 0 0 40px rgba(255,153,51,0.9), 0 0 80px rgba(255,100,30,0.6);
    }
    .hl-lantern-body::after {
        content: ''; position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%);
        width: 6px; height: 8px; background: linear-gradient(to bottom, #cc3300, transparent);
        border-radius: 0 0 3px 3px;
    }
    .hl-lantern-glow {
        position: absolute; inset: -10px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255,180,80,0.3), transparent 70%);
        animation: lanternGlow 2s ease-in-out infinite alternate;
    }

    .hl-lantern-card {
        position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%) scale(0.8);
        width: 220px; background: rgba(20,15,10,0.95); border: 1px solid rgba(212,175,55,0.4);
        border-radius: 12px; padding: 14px 16px; pointer-events: auto;
        opacity: 0; transition: all 0.35s ease; z-index: 9999;
        backdrop-filter: blur(12px); text-decoration: none; display: block;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6), 0 0 20px rgba(212,175,55,0.15);
    }
    .hl-lantern:hover .hl-lantern-card {
        opacity: 1; transform: translateX(-50%) scale(1);
    }
    .hl-lantern-card-title {
        color: #e2c079; font-size: 0.82rem; font-weight: 600; margin-bottom: 4px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .hl-lantern-card-author { color: #a89070; font-size: 0.7rem; margin-bottom: 4px; }
    .hl-lantern-card-snippet {
        color: rgba(255,255,255,0.5); font-size: 0.7rem; line-height: 1.4;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    @@keyframes lanternFloat {
        0% { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }
        5% { opacity: 0.9; }
        85% { opacity: 0.9; }
        100% { transform: translateY(-100vh) translateX(40px) rotate(8deg); opacity: 0; }
    }
    @@keyframes lanternGlow {
        from { opacity: 0.5; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1.1); }
    }

    .hl-content {
        position: relative; z-index: 10; min-height: 100vh;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 80px 20px 60px;
        pointer-events: none;
    }
    .hl-card, .hl-btn { pointer-events: auto; }
    .hl-card {
        max-width: 520px; text-align: center;
        background: rgba(20,15,12,0.85); backdrop-filter: blur(16px);
        border: 1px solid rgba(212,175,55,0.3); border-radius: 20px;
        padding: 44px 32px; box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        animation: cardAppear 0.8s ease-out;
    }
    @@keyframes cardAppear {
        from { opacity: 0; transform: translateY(30px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .hl-card h1 {
        font-family: 'Ma Shan Zheng', cursive; color: #e2c079; font-size: 2.5rem;
        margin: 0 0 8px; letter-spacing: 6px; text-shadow: 0 0 20px rgba(226,192,121,0.4);
    }
    .hl-card .hl-divider {
        width: 60px; height: 2px; margin: 12px auto 18px;
        background: linear-gradient(to right, transparent, #d4af37, transparent);
    }
    .hl-card p { color: rgba(255,255,255,0.65); line-height: 1.8; font-size: 0.95rem; }
    .hl-actions { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
    .hl-btn {
        padding: 12px 30px; border-radius: 28px;
        border: 1px solid rgba(212,175,55,0.4); background: rgba(158,42,47,0.3);
        color: #f5e6c8; font-family: 'Ma Shan Zheng', cursive; font-size: 1.05rem;
        text-decoration: none; cursor: pointer; transition: all 0.35s;
        backdrop-filter: blur(6px); letter-spacing: 2px;
    }
    .hl-btn:hover {
        background: rgba(158,42,47,0.7); border-color: #d4af37; color: #fff;
        box-shadow: 0 6px 20px rgba(158,42,47,0.4); transform: translateY(-2px);
    }
</style>
}

<div class="hl-scene" id="hlScene">
    <div class="hl-depth-layer" id="hlDepth" data-speed="0.02"></div>
</div>

<div id="lanternContainer" style="position:fixed;inset:0;z-index:15;pointer-events:none;overflow:hidden;"></div>

<div class="hl-content">
    <div class="hl-card">
        <h1>梨园心灯</h1>
        <div class="hl-divider"></div>
        <p>天坛夜色为幕，一盏心灯照见戏迷心声。<br/>悬浮灯盏承载帖文，轻触可览。</p>
        <div class="hl-actions">
            <a class="hl-btn" asp-controller="Community" asp-action="Create">点灯发帖</a>
            <a class="hl-btn" asp-controller="Community" asp-action="Index">戏词雅集</a>
            <a class="hl-btn" href="/">返回梨园</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        var posts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(postList.Select(p => new {
            id = p.Id,
            title = p.Title ?? "",
            author = p.Author?.Nickname ?? "匿名",
            snippet = System.Text.RegularExpressions.Regex.Replace(p.Content ?? "", "<.*?>", "").Substring(0, Math.Min(System.Text.RegularExpressions.Regex.Replace(p.Content ?? "", "<.*?>", "").Length, 60))
        })));
        var pIdx = 0;

        var container = document.getElementById('lanternContainer');

        function spawnLantern() {
            var l = document.createElement('div');
            l.className = 'hl-lantern';
            var inner = '<div class="hl-lantern-glow"></div><div class="hl-lantern-body"></div>';

            if (posts.length > 0) {
                var p = posts[pIdx % posts.length];
                pIdx++;
                inner += '<a href="/Community/Details/' + p.id + '" class="hl-lantern-card">'
                    + '<div class="hl-lantern-card-title">' + escHtml(p.title) + '</div>'
                    + '<div class="hl-lantern-card-author">' + escHtml(p.author) + '</div>'
                    + '<div class="hl-lantern-card-snippet">' + escHtml(p.snippet) + '</div></a>';
            }

            l.innerHTML = inner;
            var size = 16 + Math.random() * 20;
            l.style.width = size + 'px';
            l.style.left = (5 + Math.random() * 90) + '%';
            l.style.bottom = '-40px';
            l.style.animationDuration = (12 + Math.random() * 14) + 's';
            l.style.animationDelay = '0s';
            container.appendChild(l);
            setTimeout(function () { l.remove(); }, 26000);
        }

        function escHtml(s) {
            var d = document.createElement('div'); d.textContent = s; return d.innerHTML;
        }

        for (var i = 0; i < 10; i++) setTimeout(spawnLantern, i * 700);
        setInterval(spawnLantern, 2000);

        var scene = document.getElementById('hlScene');
        document.addEventListener('mousemove', function (e) {
            var mx = (e.clientX / window.innerWidth - 0.5) * 2;
            var my = (e.clientY / window.innerHeight - 0.5) * 2;
            scene.style.transform = 'scale(1.05) translate(' + (mx * -8) + 'px,' + (my * -6) + 'px)';
        });
    })();
    </script>
}
