@using System
@using OperaLearningSystem.Core.DTOs
@model PagedResult<OperaLearningSystem.Core.Entities.Course>

@{
    ViewData["Title"] = "传习私塾 - 拟真水墨丝绸卷轴";
    var searchString = ViewData["CurrentFilter"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
    var modeFlag = ViewData["CourseBrowseMode"] as string;
    var browseMode = !string.IsNullOrWhiteSpace(modeFlag)
        ? modeFlag.Trim()
        : (string.IsNullOrWhiteSpace(searchString) ? "spotlight" : "search");
    var isSpotlight = string.Equals(browseMode, "spotlight", StringComparison.OrdinalIgnoreCase);
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize) : 0;
    var currentPage = Model.PageNumber;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/Course/index.css" asp-append-version="true" />
}

<div class="sishu-root">
    <div class="sishu-bg-particles" id="bgParticles"></div>

    <header class="sishu-header">
        <div class="sishu-plaque">
            <span class="plaque-deco left"></span>
            <h1>传习私塾</h1>
            <span class="plaque-deco right"></span>
        </div>
        <p class="sishu-subtitle">—— 传道 · 授业 · 解惑 ——</p>
    </header>

    <form asp-action="Index" method="get" class="sishu-search">
        @if (categoryId.HasValue && categoryId.Value > 0)
        {
            <input type="hidden" name="categoryId" value="@categoryId.Value" />
        }
        <div class="sishu-search-inner">
            <i class="fas fa-search"></i>
            <input type="text" name="searchString" placeholder="寻觅雅集课程..." value="@searchString" />
            <button type="submit">搜索</button>
        </div>
    </form>

    <div class="bookshelf" id="bookshelf" data-browse-mode="@browseMode">
        <div class="shelf-top-shadow"></div>

        @if (Model.Items.Any())
        {
            if (isSpotlight)
            {
                <p class="carousel-hint">左右拨动书架翻看，点击书卷展卷研习</p>
                <div class="carousel-viewport" id="carouselViewport" role="application" aria-label="3D旋转木马书架">
                    <div class="carousel-pivot">
                        <div class="carousel-axis" id="carouselAxis">
                            @foreach (var item in Model.Items)
                            {
                                <div class="carousel-cell">
                                    <div class="scroll-book scroll-book--carousel3d" data-course-id="@item.Id"
                                         data-study-url="@Url.Action("Study", "Course", new { id = item.Id })">
                                        <span class="scroll-ground-shadow" aria-hidden="true"></span>

                                        <div class="scroll-rod-t"></div>

                                        <div class="scroll-spine">
                                            <span class="spine-text">@item.Name</span>
                                            @if (item.IsFeatured)
                                            {
                                                <span class="spine-badge">精</span>
                                            }
                                        </div>

                                        <div class="scroll-rod-b"></div>

                                        <div class="scroll-tooltip">
                                            <strong class="tooltip-title">@item.Name</strong>
                                            <span class="tooltip-cat">@(item.Category?.Name ?? "未分类")</span>
                                            <span class="tooltip-hint">点击展卷研习</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="carousel-floor"></div>
                </div>
            }
            else
            {
                <p class="shelf-search-hint"><i class="fas fa-list"></i> 以下为寻得的雅集课程</p>
                <div class="shelf-row shelf-row--grid">
                    @foreach (var item in Model.Items)
                    {
                        <div class="scroll-book" data-course-id="@item.Id"
                             data-study-url="@Url.Action("Study", "Course", new { id = item.Id })">
                            <div class="scroll-rod-t"></div>

                            <div class="scroll-spine">
                                <span class="spine-text">@item.Name</span>
                                @if (item.IsFeatured)
                                {
                                    <span class="spine-badge">精</span>
                                }
                            </div>

                            <div class="scroll-rod-b"></div>

                            <div class="scroll-tooltip">
                                <strong class="tooltip-title">@item.Name</strong>
                                <span class="tooltip-cat">@(item.Category?.Name ?? "未分类")</span>
                                <span class="tooltip-hint">点击展卷研习</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="shelf-row shelf-row--empty">
                <div class="shelf-empty">
                    <i class="fas fa-scroll"></i>
                    <p>书架空空，未寻得相关课程残卷。</p>
                </div>
            </div>
        }

        <div class="shelf-board"></div>
    </div>

    @if (!isSpotlight && totalPages > 1)
    {
        <nav class="sishu-pagination">
            <ul>
                <li class="@(currentPage == 1 ? "disabled" : "")">
                    <a asp-action="Index" asp-route-pageNumber="1" asp-route-searchString="@searchString" asp-route-categoryId="@categoryId">首页</a>
                </li>
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="@(i == currentPage ? "active" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@searchString" asp-route-categoryId="@categoryId">@i</a>
                    </li>
                }
                <li class="@(currentPage == totalPages ? "disabled" : "")">
                    <a asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-searchString="@searchString" asp-route-categoryId="@categoryId">尾页</a>
                </li>
            </ul>
        </nav>
    }

    <div class="sishu-back">
        @if (categoryId.HasValue && categoryId.Value > 0)
        {
            <a asp-controller="Category" asp-action="Details" asp-route-id="@categoryId.Value">返回剧种方志</a>
        }
        <a asp-controller="Home" asp-action="Index">返回首页</a>
    </div>
</div>

<div class="scroll-overlay-backdrop" id="scrollOverlay">
    <div class="scroll-overlay">
        <div class="scroll-rod"></div>
        <div class="scroll-paper" id="scrollPaper">
            <button class="sp-close" id="scrollClose">&times;</button>
            <h2 id="spTitle"></h2>
            <div class="sp-cat" id="spCat"></div>
            <div class="sp-desc" id="spDesc"></div>
            <div class="sp-actions">
                <a class="sp-btn sp-btn-primary" id="spStudyBtn">研习此卷</a>
                <a class="sp-btn sp-btn-secondary" id="spDetailsBtn" href="#">残卷详情</a>
            </div>
        </div>
        <div class="scroll-rod"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/Course/index.js" asp-append-version="true"></script>
}